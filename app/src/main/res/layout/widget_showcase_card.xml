<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_dark_bg"
    android:padding="16dp">

    <!-- Top Header: Logo + Cast -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_soundwave_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_soundwave_logo"
                android:contentDescription="@string/widget_echo_music" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/widget_echo_music"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_title" />
        </LinearLayout>

        <!-- Cast / Output Button -->
        <FrameLayout
            android:id="@+id/widget_cast_button"
            android:layout_width="32dp"
            android:layout_height="32dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_cast_white"
                android:contentDescription="@string/widget_cast" />
        </FrameLayout>

    </LinearLayout>

    <!-- Hero Artwork Banner -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/album_art" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_artwork_scrim"
            android:scaleType="fitXY" />

    </FrameLayout>

    <!-- Song Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/widget_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/not_playing"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_title"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_play"
            android:textSize="13sp"
            android:textColor="@color/widget_text_subtitle"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Progress Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/widget_progress_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_progress_track_modern"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/widget_progress_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_progress_clip_modern"
                android:scaleType="fitXY" />
        </FrameLayout>

        <!-- Timestamps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/widget_time_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/widget_text_subtitle" />

            <TextView
                android:id="@+id/widget_time_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/widget_text_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Heart / Like -->
        <FrameLayout
            android:id="@+id/widget_like_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_circle_button_bg">

            <ImageView
                android:id="@+id/widget_like_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_heart_clean"
                android:contentDescription="@string/like" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Previous -->
        <FrameLayout
            android:id="@+id/widget_prev_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_circle_button_bg">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_skip_prev_white"
                android:contentDescription="@string/previous" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Play / Pause Button -->
        <FrameLayout
            android:id="@+id/widget_play_pause_container"
            android:layout_width="54dp"
            android:layout_height="54dp">

            <ImageView
                android:id="@+id/widget_play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_circle_play_accent_bg" />

            <ImageView
                android:id="@+id/widget_play_pause"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_play_bold_white"
                android:contentDescription="@string/play_pause" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Next -->
        <FrameLayout
            android:id="@+id/widget_next_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_circle_button_bg">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_skip_next_white"
                android:contentDescription="@string/next" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- More Options (...) -->
        <FrameLayout
            android:id="@+id/widget_options_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_circle_button_bg">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_more_dots"
                android:contentDescription="@string/widget_options" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
