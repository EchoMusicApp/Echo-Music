<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_dark_bg"
    android:padding="10dp"
    android:gravity="center">

    <!-- Centered Album Art -->
    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/album_art" />

    <!-- Centered Song Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="5dp">

        <TextView
            android:id="@+id/widget_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/not_playing"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_title"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_play"
            android:textSize="10.5sp"
            android:textColor="@color/widget_text_subtitle"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- Centered Playback Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <!-- Previous -->
        <FrameLayout
            android:id="@+id/widget_prev_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_circle_button_bg">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_skip_prev_white"
                android:contentDescription="@string/previous" />
        </FrameLayout>

        <!-- Play / Pause Button -->
        <FrameLayout
            android:id="@+id/widget_play_pause_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp">

            <ImageView
                android:id="@+id/widget_play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_circle_play_accent_bg" />

            <ImageView
                android:id="@+id/widget_play_pause"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_play_bold_white"
                android:contentDescription="@string/play_pause" />
        </FrameLayout>

        <!-- Next -->
        <FrameLayout
            android:id="@+id/widget_next_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_circle_button_bg">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_skip_next_white"
                android:contentDescription="@string/next" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
