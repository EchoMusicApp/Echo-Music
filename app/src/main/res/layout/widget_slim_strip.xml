<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_card_dark_bg"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <!-- Album Art -->
    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/album_art" />

    <!-- Center Info & Progress -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <!-- Title & Artist -->
        <TextView
            android:id="@+id/widget_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/not_playing"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_title"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_play"
            android:textSize="11sp"
            android:textColor="@color/widget_text_subtitle"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />

        <!-- Progress Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/widget_progress_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_progress_track_modern"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/widget_progress_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_progress_clip_modern"
                android:scaleType="fitXY" />
        </FrameLayout>

        <!-- Timestamps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="1dp">

            <TextView
                android:id="@+id/widget_time_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textSize="9sp"
                android:textColor="@color/widget_text_subtitle" />

            <TextView
                android:id="@+id/widget_time_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="9sp"
                android:textColor="@color/widget_text_subtitle" />
        </LinearLayout>

    </LinearLayout>

    <!-- Right Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Previous -->
        <FrameLayout
            android:id="@+id/widget_prev_button"
            android:layout_width="30dp"
            android:layout_height="30dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_skip_prev_white"
                android:contentDescription="@string/previous" />
        </FrameLayout>

        <!-- Play / Pause -->
        <FrameLayout
            android:id="@+id/widget_play_pause_container"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp">

            <ImageView
                android:id="@+id/widget_play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_circle_play_accent_bg" />

            <ImageView
                android:id="@+id/widget_play_pause"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_play_bold_white"
                android:contentDescription="@string/play_pause" />
        </FrameLayout>

        <!-- Next -->
        <FrameLayout
            android:id="@+id/widget_next_button"
            android:layout_width="30dp"
            android:layout_height="30dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_skip_next_white"
                android:contentDescription="@string/next" />
        </FrameLayout>

        <!-- Cast -->
        <FrameLayout
            android:id="@+id/widget_cast_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_circle_button_bg">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_cast_white"
                android:contentDescription="@string/widget_cast" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
