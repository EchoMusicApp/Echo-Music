
# ============================================================
# ECHO WEB — Git Ignore
# React + TypeScript + Vite
# ============================================================


# ------------------------------------------------------------
# 1. Dependencies
# ------------------------------------------------------------

node_modules/
jspm_packages/
bower_components/

# Package manager caches
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# Keep package manager configuration and lockfiles tracked.
# package-lock.json
# pnpm-lock.yaml
# yarn.lock


# ------------------------------------------------------------
# 2. Build output
# ------------------------------------------------------------

dist/
build/
out/
release/
coverage/

# Bundler and build caches
.vite/
.cache/
.parcel-cache/
.turbo/
.esbuild/
.rollup.cache/

# TypeScript incremental build information
*.tsbuildinfo


# ------------------------------------------------------------
# 3. Environment variables and secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.*.example

# Local environment overrides
*.local

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.jks
*.keystore

# Credentials and tokens
credentials.json
secrets.json
service-account*.json
firebase-adminsdk*.json


# ------------------------------------------------------------
# 4. Logs and debugging
# ------------------------------------------------------------

*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

report.*.json
debug.log


# ------------------------------------------------------------
# 5. IDEs and editors
# ------------------------------------------------------------

# JetBrains
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
# Keep shared workspace recommendations and settings tracked.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Other editors
*.sublime-workspace
*.sublime-project


# ------------------------------------------------------------
# 6. Operating systems
# ------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# ------------------------------------------------------------
# 7. Testing and test artifacts
# ------------------------------------------------------------

playwright-report/
test-results/
blob-report/
.nyc_output/
cypress/videos/
cypress/screenshots/

# Temporary test files
*.spec.tmp
*.test.tmp


# ------------------------------------------------------------
# 8. Browser automation and local tooling
# ------------------------------------------------------------

.selenium/
.puppeteer/
.browser-profile/
.chrome-profile/


# ------------------------------------------------------------
# 9. PWA and generated assets
# ------------------------------------------------------------

# Generated service worker / Workbox output
dev-dist/

# Keep source icons, manifests and images in public/.
# Do not ignore public/ itself.


# ------------------------------------------------------------
# 10. Deployment and hosting
# ------------------------------------------------------------

.vercel/
.netlify/
.wrangler/
.firebase/

# Local deployment state
.terraform/
*.tfstate
*.tfstate.*
crash.log


# ------------------------------------------------------------
# 11. Temporary files
# ------------------------------------------------------------

tmp/
temp/
.temp/
.cache-loader/

*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig
*.rej


# ------------------------------------------------------------
# 12. Large generated media and local databases
# ------------------------------------------------------------

# Local development databases (do not ignore application assets)
*.sqlite
*.sqlite3
*.db-journal

# Local audio/video test downloads
# Store intentional sample assets in a dedicated tracked folder.
